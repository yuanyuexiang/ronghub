# Browser build configuration; values below are public.
API_ORIGIN=http://127.0.0.1:8000

# Optional customer-approved WGS84/EPSG:3857 raster tiles. Leave blank for local coordinate grid.
# Both values are required; use https:// or a same-origin /path/{z}/{x}/{y} template.
# NEXT_PUBLIC values are shipped to browsers: never put server secrets here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
